#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        COMBO_NewFolder_Mac {
            bindings = <&kp LG(LS(N))>;
            key-positions = <6 7>;
            layers = <0>;
        };

        COMBO_NewFolder_Win {
            bindings = <&kp LC(LS(N))>;
            key-positions = <6 7>;
            layers = <1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer_for_mac {
            bindings = <
&kp ESC    &kp Q             &kp W         &kp E             &kp R     &kp T                        &kp Y  &kp U     &kp I                 &kp O       &kp P              &trans
&kp TAB    &kp A             &kp S         &kp D             &kp F     &kp G                        &kp H  &kp J     &kp K                 &kp L       &kp SEMI           &kp SQT
&kp LSHFT  &kp Z             &kp X         &kp C             &kp V     &kp B                        &kp N  &kp M     &kp COMMA             &kp DOT     &kp FSLH           &kp BACKSLASH
&trans     &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LC(UP_ARROW)  &kp LGUI  &mo 2  &kp SPACE  &kp ENTER  &mo 3  &kp BSPC  &kp LG(LS(NUMBER_4))  &kp C_MUTE  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP
            >;
        };

        lower_layer_for_windows {
            bindings = <
&kp ESC         &kp Q         &kp W         &kp E      &kp R      &kp T                        &kp Y  &kp U          &kp I      &kp O       &kp P              &kp LA(F4)
&kp TAB         &kp A         &kp S         &kp D      &kp F      &kp G                        &kp H  &kp J          &kp K      &kp L       &kp SEMICOLON      &kp SQT
&kp LEFT_SHIFT  &kp Z         &kp X         &kp C      &kp V      &kp B                        &kp N  &kp M          &kp COMMA  &kp PERIOD  &kp SLASH          &kp BACKSLASH
&trans          &kp LEFT_WIN  &kp LEFT_ALT  &kp LANG1  &kp LCTRL  &mo 2  &kp SPACE  &kp ENTER  &mo 3  &kp BACKSPACE  &kp LANG2  &kp C_MUTE  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP
            >;
        };

        raise_layer {
            bindings = <
&trans  &kp N1        &kp N2        &kp N3        &kp N4        &kp N5                        &trans  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_PLUS      &trans
&trans  &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0                  &trans  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_MINUS     &trans
&trans  &kp F6        &kp F7        &kp F8        &kp F9        &kp F10                       &trans  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_ASTERISK  &trans
&trans  &trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans  &trans           &kp KP_NUMBER_0  &kp KP_DOT       &kp KP_DIVIDE    &trans
            >;
        };

        other_layer {
            bindings = <
&trans  &kp EXCLAMATION  &kp AT_SIGN    &kp HASH      &kp DOLLAR            &kp PERCENT                            &kp PG_UP      &kp HOME          &kp UP    &kp END            &kp PRINTSCREEN  &trans
&trans  &kp CARET        &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS                  &kp PAGE_DOWN  &kp LEFT          &kp DOWN  &kp RIGHT          &kp SCROLLLOCK   &trans
&trans  &kp GRAVE        &kp SQT        &kp SEMI      &kp LEFT_BRACKET      &kp RIGHT_BRACKET                      &kp LG(LEFT)   &kp LC(LG(LEFT))  &trans    &kp LC(LG(RIGHT))  &kp LG(RIGHT)    &trans
&trans  &trans           &trans         &trans        &trans                &trans                 &trans  &trans  &trans         &trans            &trans    &trans             &trans           &trans
            >;
        };

        fun_bt_layer {
            bindings = <
&trans  &kp F1   &kp F2   &kp F3   &kp F4   &kp F5                   &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans
&trans  &kp F6   &kp F7   &kp F8   &kp F9   &kp F10                  &bt BT_CLR      &bt BT_CLR_ALL  &trans        &to 0         &to 1         &trans
&trans  &kp F11  &kp F12  &kp F13  &kp F14  &kp F15                  &studio_unlock  &trans          &trans        &trans        &trans        &trans
&kp O   &kp M    &kp U    &trans   &trans   &trans   &trans  &trans  &trans          &trans          &trans        &kp K         &kp E         &kp N
            >;
        };
    };
};
